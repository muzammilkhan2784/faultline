# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=faultline-dev
NEO4J_DATABASE=neo4j

# Ingestion safety limits (see README > Security)
ALLOWED_ROOT=/tmp/faultline-repos
MAX_REPO_FILES=20000
MAX_REPO_MB=500
CLONE_TIMEOUT_SECONDS=300

# API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=INFO
